{
  "name": "waline-root",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "admin:build": "pnpm --dir=packages/admin build",
    "admin:dev": "pnpm --dir=packages/admin dev",
    "api:build": "pnpm --dir=packages/api build",
    "api:docs": "mkdir -p docs/src/.vuepress/dist/api && redocly build-docs packages/server/openapi.yaml --output docs/src/.vuepress/dist/api/index.html",
    "api:lint": "redocly lint packages/server/openapi.yaml",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "client:build": "pnpm --dir=packages/client build",
    "client:dev": "pnpm --dir=packages/client dev",
    "dev": "turbo run dev",
    "docs:build": "pnpm --dir=docs run build && pnpm api:docs",
    "docs:dev": "pnpm --dir=docs run dev",
    "lint": "pnpm oxlint --fix && oxfmt && pnpm lint:stylelint --fix",
    "lint:check": "pnpm oxlint && oxfmt --check && pnpm lint:stylelint",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:stylelint": "stylelint packages/*/src/**/*.scss",
    "packages:check-update": "pnpm dlx npm-check-updates",
    "packages:update": "pnpm dlx npm-check-updates && pnpm -r up",
    "prepare": "husky install",
    "server:dev": "pnpm --dir=packages/server dev",
    "server:vercel": "vercel dev ./example --listen 9090",
    "test": "vitest"
  },
  "dependencies": {
    "turbo": "^2.11.10",
    "waline-root": "link:"
  },
  "devDependencies": {
    "@babel/runtime": "8.0.10",
    "@mr-hope/tsconfig": "0.0.4",
    "@mr-hope/verify-commit-message": "0.1.1",
    "@redocly/cli": "2.72.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "10.1.0",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.24.0",
    "nano-staged": "1.0.2",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "picocolors": "1.1.1",
    "postcss": "8.5.32",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "stylelint": "17.16.0",
    "stylelint-config-hope": "12.1.0",
    "tsdown": "0.23.4",
    "typescript": "catalog:",
    "unrun": "0.3.1",
    "vercel": "65.5.0",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "5.0.3",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.5"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts,vue}": "oxlint --fix",
    "*.md": "markdownlint-cli2 --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || ^26.13.0",
      "onFail": "error"
    }
  }
}
