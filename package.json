{
  "name": "waline-root",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "admin:build": "pnpm --dir=packages/admin build",
    "admin:dev": "pnpm --dir=packages/admin dev",
    "api:build": "pnpm --dir=packages/api build",
    "api:docs": "mkdir -p docs/src/.vuepress/dist/api && redocly build-docs packages/server/openapi.yaml --output docs/src/.vuepress/dist/api/index.html --disableGoogleFont",
    "api:lint": "redocly lint packages/server/openapi.yaml",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "client:build": "pnpm --dir=packages/client build",
    "client:dev": "pnpm --dir=packages/client dev",
    "dev": "turbo run dev",
    "docs:build": "pnpm --dir=docs run build && pnpm api:docs",
    "docs:dev": "pnpm --dir=docs run dev",
    "lint": "turbo run lint",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:oxlint": "oxlint --fix --report-unused-disable-directives",
    "lint:stylelint": "stylelint packages/*/src/**/*.scss --fix",
    "packages:check-update": "pnpm dlx npm-check-updates",
    "packages:update": "pnpm dlx npm-check-updates && pnpm -r up",
    "prepare": "husky install",
    "server:dev": "pnpm --dir=packages/server dev",
    "server:vercel": "vercel dev ./example --listen 9090",
    "test": "turbo run test"
  },
  "dependencies": {
    "turbo": "^1.11.3",
    "waline-root": "link:"
  },
  "devDependencies": {
    "@babel/runtime": "8.0.0",
    "@mr-hope/tsconfig": "0.0.4",
    "@redocly/cli": "2.51.2",
    "@types/node": "24.19.0",
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "10.1.0",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.2",
    "nano-staged": "1.0.2",
    "oxc-config-hope": "0.3.13",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "picocolors": "1.1.1",
    "postcss": "8.5.28",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "sass-embedded": "1.104.0",
    "stylelint": "17.15.0",
    "stylelint-config-hope": "12.1.0",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "unrun": "0.3.1",
    "vercel": "59.11.7",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.0"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts,vue}": "oxlint --fix --type-aware --type-check --report-unused-disable-directives",
    "*.md": "markdownlint-cli2 --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.22.0 || ^24.20.0 || ^26.3.0",
      "onFail": "error"
    }
  }
}
